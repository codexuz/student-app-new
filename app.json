{
  "expo": {
    "name": "Impulse Student App",
    "slug": "impulse-app",
    "version": "1.3.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "edu.impulse.uz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "32",
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "light": "./assets/images/ios-light.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "edu.impulse.uz",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "supportsTablet": false,
      "infoPlist": {
        "AppStoreID": "6757120304",
        "AppStoreCountry": "uz",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "versionCode": 32,
      "adaptiveIcon": {
        "backgroundColor": "#1055F8",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "edu.impulse.uz",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1055F8",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-video"
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to record a video for speaking challenge exercise.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record your voice for speaking challenge exercise.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record your voice for speaking exercises and audio calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select images for your profile.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take a picture for your profile."
        }
      ],
      "expo-updates",
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "./plugins/withAndroidR8FullMode.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71d1965c-3d1c-4fc2-88d1-c7e61333e224"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71d1965c-3d1c-4fc2-88d1-c7e61333e224"
    }
  }
}
